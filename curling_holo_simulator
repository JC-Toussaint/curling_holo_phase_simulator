def configure_arguments():
    """
    Configures the command-line argument parser.
    
    Returns:
        argparse.Namespace: The parsed arguments.
    """
    description_text = "Solving the curling mode with custom parameters."
    
    exemples = """
    usage examples:
         %(prog)s 1000 2e-10 --Ku=-1e4 --R 100e-9
         %(prog)s 1000 2e-10 --A 1.5e-11 --Ku=-2e4 --R 100e-9 --no-plots
    """

    parser = argparse.ArgumentParser(
        description=description_text,
        epilog=exemples,
        formatter_class=CustomHelpFormatter,
        prefix_chars='-+' # Better handling of plus and minus signs
    )

    # Required positional arguments
    parser.add_argument('IMAGE_SIZE', type=int, help="Final size of the PNG image (IMAGE_SIZE x IMAGE_SIZE)")
    parser.add_argument('PIXEL_SIZE', type=float, help="Size of a pixel in meters (replaces dx and dy)")

    # Optional arguments
    parser.add_argument('--A',  type=float, default = 1.3e-11, help="Exchange constant (J/m)")
    parser.add_argument('--Ku', type=float, default = -1e4, help="Uniaxial anisotropy constant (J/m^3)")
    parser.add_argument('--Ms', type=float, default = 1.00531 / mu_0, help="Magnetization (A/m)")
    parser.add_argument('--R',  type=float, default = 100e-9, help="Outer radius of the cylinder (m)")
    parser.add_argument('--lbp', type=float, default = 0.01, help="STXM absorption coefficient for sigma=+1 (1/nm)")
    parser.add_argument('--lbm', type=float, default = 0.018, help="STXM absorption coefficient for sigma=-1 (1/nm)")
    
    # New options to disable figure displaying/generation
    parser.add_argument('--no-plots', '--nograph', action='store_true', dest='no_plots',
                        help="Disable figure display and rendering (faster execution)")

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    return parser.parse_args()


def simulate_curling():
    """
    Runs the core physical simulation: stability diagnostics,
    solving the boundary value problem (BVP), computing the integral projection,
    and computing the holographic phase.
    
    Returns:
        tuple: (rho_grid, omega_bvp, y_vals, I_vals, phase_vals, thick_vals, contrast_vals)
    """
    # --- Step A: Solution estimate and stability diagnostics ---
    if Ku != 0:
        l_K = np.sqrt(A / abs(Ku))
        Rc = 1.8412 * l_K # 1.8412 first positive root of J1'(x)
        print(f"Estimated critical radius R_c = {Rc*1e9:.2f} nm (current R = {R*1e9:.1f} nm)")
 
        if Ku > 0 or R < Rc:
            print(">>> Warning: Stable configuration expected toward the trivial solution omega(rho) = 0.")
        else:
            print(">>> Favorable configuration: Non-trivial curling profile expected.")

    # --- Step B: Solving the ODE (BVP) ---
    # Grid refined near the core (quadratic spacing) to resolve the boundary
    # layer of width ~ l_K/R = 1/sqrt(2|kappa|), which is very thin for large |kappa|
    rho_grid = epsilon + (1.0 - epsilon) * np.linspace(0.0, 1.0, N_BVP)**2
    # 'guess' profile to push the solver toward the non-trivial solution
    if Ku < 0:
        # The guess must vary on the physical length scale l_K/R, otherwise
        # solve_bvp diverges toward oscillating branches when |kappa| >> 1
        k = np.sqrt(2 * abs(kappa))
        omega_guess = (np.pi / 2) * np.tanh(k * rho_grid)
    else:
        omega_guess = 0 * rho_grid
    y_guess = np.vstack([omega_guess, np.gradient(omega_guess, rho_grid)])

    sol = solve_bvp(ode_curling, bc_curling, rho_grid, y_guess, tol=1e-7, max_nodes=1000000)
    print("[Euler-Lagrange / BVP] Convergence status:", sol.message)
    omega_bvp = sol.sol(rho_grid)[0]

    # --- Step B bis: Check convergence and that omega(rho) is monotonically increasing ---
    # Derivative of omega with respect to rho, evaluated on the grid via the spline
    domega_drho_bvp = sol.sol(rho_grid)[1]

    if sol.status != 0:
        print(f"{RED}[Euler-Lagrange / BVP] ERROR:{RESET} solve_bvp did not converge "
              f"(status {sol.status}: {sol.message})", file=sys.stderr)
        print(f"kappa = {kappa:.4g}: no physically admissible curling profile was found.",
              file=sys.stderr)
        sys.exit(1)

    if np.all(domega_drho_bvp >= -1e-12):  # numerical tolerance
        print(f"{GREEN}[Monotonicity]{RESET} omega(rho) is increasing over the entire domain.")
    else:
        print(f"{RED}[Monotonicity] ERROR:{RESET} omega(rho) is not monotonically increasing "
              f"over the domain (min domega/drho = {domega_drho_bvp.min():.3e}).", file=sys.stderr)
        print(f"kappa = {kappa:.4g}: the BVP solution does not satisfy the expected physical behavior.",
              file=sys.stderr)
        sys.exit(1)

    # --- Step C: Computing the integration profile I(y) ---
    # Vectorization of the function for optimized execution over a NumPy array
    compute_I_vectorized = np.vectorize(lambda y: compute_I(y, R, sol.sol))
    
    # Pixel-centered grid: exactly IMAGE_SIZE points, symmetric with respect to y = 0
    y_vals = (np.arange(IMAGE_SIZE) - (IMAGE_SIZE - 1) / 2) * PIXEL_SIZE
    # Half grid y >= 0 (y = 0 included so that the phase integration starts at 0)
    y_half = np.unique(np.concatenate(([0.0], np.abs(y_vals))))
    print(f"[Computation] Evaluating I(y) over {y_half.size} points...")
    I_half = compute_I_vectorized(y_half)

    # --- Step D: Computing the phase Phi(y) ---
    # Integration using the trapezoidal method
    phase_half = cumulative_trapezoid(I_half, y_half, initial=0)
    phase_half *= -e_c / hbar

    # symmetrization (I(y) is even, Phi(y) is odd)
    idx = np.searchsorted(y_half, np.abs(y_vals))
    I_vals = I_half[idx]
    phase_vals = np.sign(y_vals) * phase_half[idx]

    # Computing the thickness profile
    thick_vals = 2 * np.sqrt(np.maximum(0, R**2 - y_vals**2))

    # --- Step E: Computing the STXM (XMCD) contrast ---
    # The absorption coefficient depends on m_z: 0.5*(lbp + lbm + sigma*(lbp - lbm)*m_z)
    # Integral of m_z along the beam (m), recovered from I(y) = -mu_0 * Ms * int m_z dz
    mz_path = -I_vals / (mu_0 * Ms)
    # lbp and lbm are given in 1/nm, lengths in m
    inm = 1e9
    arg_plus  = 0.5 * inm * ((lbp + lbm) * thick_vals + (lbp - lbm) * mz_path)  # sigma=+1
    arg_minus = 0.5 * inm * ((lbp + lbm) * thick_vals - (lbp - lbm) * mz_path)  # sigma=-1
    I_plus  = np.exp(-arg_plus)
    I_minus = np.exp(-arg_minus)
    contrast_vals = (I_plus - I_minus) / (I_plus + I_minus)

    return rho_grid, omega_bvp, y_vals, I_vals, phase_vals, thick_vals, contrast_vals


def generate_plots(rho_grid, omega_bvp, y_vals, phase_vals, show_plots=True):
    """
    Generates and saves the simulation's control plots.
    """
    if not show_plots:
        return

    print("[Plots] Generating control plots...")
    
    # Fig 1: Dimensionless curling profile
    plt.figure(figsize=(6, 4))
    plt.plot(rho_grid, omega_bvp, '-', lw=2.5, color='tab:orange', label="BVP (Spline)")
    plt.xlabel(r'$\rho = r/R$')
    plt.ylabel(r'$\omega(\rho)$ [rad]')
    plt.title("Dimensionless profile of the curling mode")
    plt.grid(alpha=0.3)
    plt.tight_layout()
    plt.savefig(os.path.join(SCRIPT_DIR, 'curling_mode_adim.png'), dpi=150)
    plt.show()

    # Fig 3: Phase profile Phi(y)
    plt.figure(figsize=(6, 4))
    plt.plot(y_vals * 1e9, phase_vals, '-', lw=2.5, color='tab:purple', label=r'$\Phi(y)$')
    plt.axvline(0, color='black', linestyle='--', alpha=0.4)
    plt.axhline(0, color='black', linestyle='--', alpha=0.4)

    # --- EXTREMA VALUES ---
    phase_min, phase_max = np.min(phase_vals), np.max(phase_vals)
    print(f"phase : [{phase_min:.6g}, {phase_max:.6g}]")
    
    # Text to display (using LaTeX expressions for Greek symbols)
    info_text = (
        f"$\\Phi_{{min}}$: {phase_min:.4f} rad\n"
        f"$\\Phi_{{max}}$: {phase_max:.4f} rad\n"
        f"$R$: {R*1e9:.1f} nm"
    )

    # Placing the text in relative plot coordinates (0.05 = 5% from the left edge, 0.80 = 80% from the bottom)
    plt.text(0.05, 0.80, info_text, transform=plt.gca().transAxes,
             fontsize=10, verticalalignment='top',
             bbox=dict(boxstyle='round,pad=0.5', facecolor='white', alpha=0.8, edgecolor='gray'))

    plt.xlabel(r'$y$ [nm]')
    plt.ylabel(r'$\Phi(y)$ [rad]')
    plt.title(r'Holographic Phase Profile $\Phi(y)$')
    plt.grid(alpha=0.3)
    plt.tight_layout()
    plt.savefig(os.path.join(SCRIPT_DIR, 'phase_profile_y.png'), dpi=150)
    plt.show()


def export_16bit_maps(I_vals, phase_vals, thick_vals, contrast_vals, show_plots=True):
    """
    Generates, normalizes and exports the 2D grayscale 16-bit images
    (Integral of Mz map, Phase map, Thickness map and STXM contrast map)
    with their respective metadata.
    """
    # --- Retrieve the current date and time ---
    maintenant = datetime.now()
    date_creation = maintenant.strftime("%Y-%m-%d")
    heure_creation = maintenant.strftime("%H:%M:%S")

    # -------------------------------------------------------------------------
    # EXPORT INTEGRAL OF MZ MAP (16-BIT PNG) + METADATA
    # -------------------------------------------------------------------------
    I_min, I_max = np.min(I_vals), np.max(I_vals)
    print(f"[Image] I min: {I_min:.4e} | I max: {I_max:.4e}")

    if I_max != I_min:
        I_normalized = (I_vals - I_min) / (I_max - I_min) * 65535
    else:
        I_normalized = np.zeros_like(I_vals)

    I_16bit = I_normalized.astype(np.uint16)
    I_map_2d = np.tile(I_16bit, (IMAGE_SIZE, 1))

    img_I = Image.fromarray(I_map_2d)

    metadata_I = PngInfo()
    metadata_I.add_text("Simulation_Type", "Curling Holo Phase Simulator - Integral of Mz Map")
    metadata_I.add_text("Creation_Date", date_creation)
    metadata_I.add_text("Creation_Time", heure_creation)

    metadata_I.add_text("Param_A", str(A))
    metadata_I.add_text("Param_Ku", str(Ku))
    metadata_I.add_text("Param_Ms", str(Ms))
    metadata_I.add_text("Param_R", str(R))
    metadata_I.add_text("Param_r0", str(r0))
    metadata_I.add_text("Param_kappa", str(kappa))
