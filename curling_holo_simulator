    print(f"{GREEN}[Sucess]{RESET} 16-bit image (with metadata) saved to:\n -> {output_image_path_I}")

    if show_plots:
        plt.imshow(img_I, cmap="gray")
        plt.show()

    # -------------------------------------------------------------------------
    # EXPORT HOLOGRAPHIC PHASE MAP (16-BIT PNG) + METADATA
    # -------------------------------------------------------------------------
    phase_min, phase_max = np.min(phase_vals), np.max(phase_vals)
    print(f"[Image] Phase min: {phase_min:.4e} | Phase max: {phase_max:.4e}")

    # Strict linear normalization within the 16-bit encoding range [0, 65535]
    if phase_max != phase_min:
        phase_normalized = (phase_vals - phase_min) / (phase_max - phase_min) * 65535
    else:
        phase_normalized = np.zeros_like(phase_vals)

    # Explicit cast of the array to the unsigned 16-bit integer type
    phase_16bit = phase_normalized.astype(np.uint16)

    # Creation of the 2D matrix (strict phase invariance along the z axis)
