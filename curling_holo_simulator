def export_profiles(y_vals, I_vals, phase_vals, thick_vals, contrast_vals):
    """
    Saves the profiles along Ox (Integral of Mz, holographic phase, path length and STXM contrast)
    as CSV files, with the x coordinate in nm.
    """
    x_nm = y_vals * 1e9
    profiles = [
        ('profile_MZ_INTEGRAL.csv', 'I (T.m)',          I_vals),
        ('profile_HOLO_PHASE.csv',  'Phase (rad)',      phase_vals),
        ('profile_PATH_LENGTH.csv', 'Path length (m)',  thick_vals),
        ('profile_STXM_XMCD.csv',   'Contrast (dimless)', contrast_vals),
    ]
    for filename, label, values in profiles:
        output_path = os.path.join(SCRIPT_DIR, filename)
        np.savetxt(output_path, np.column_stack((x_nm, values)), delimiter=',',
                   header=f"x (nm),{label}", comments='')
        print(f"{GREEN}[Sucess]{RESET} Profile saved to:\n -> {output_path}")


# =============================================================================
# 5. MAIN EXECUTION
