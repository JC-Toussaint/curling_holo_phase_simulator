if __name__ == "__main__":
    t_start_global = time.perf_counter()
   
    # 1. Argument handling and parsing
    args = configure_arguments()

    # --- Make the variables global for the script's functions ---
    global A, Ku, Ms, R, kappa, epsilon, r0, IMAGE_SIZE, PIXEL_SIZE, lbp, lbm

    # Retrieving positional and optional arguments
    IMAGE_SIZE = args.IMAGE_SIZE
    PIXEL_SIZE = args.PIXEL_SIZE
    A = args.A          # Exchange constant (J/m)
    Ku = args.Ku        # Uniaxial anisotropy constant (J/m^3)
    Ms = args.Ms        # Magnetization (A/m)
    R = args.R          # Outer radius in m
    lbp = args.lbp      # STXM absorption coefficient, sigma=+1 (1/nm)
    lbm = args.lbm      # STXM absorption coefficient, sigma=-1 (1/nm)

    show_plots = not args.no_plots

    # --- Computing dependent variables ---
    r0 = R * 1e-6                  # Core radius (numerical singularity avoided), very small compared to R
    kappa = (Ku * R**2) / (2 * A)  # dimensionless quantity
    epsilon = r0 / R               # dimensionless parameter

    # --- Displaying the arguments in the terminal ---
    print("\n" + "="*50)
    print("PARAMETERS OF THE CURRENT SIMULATION:")
    print(f" -> IMAGE_SIZE : {IMAGE_SIZE}")
    print(f" -> PIXEL_SIZE : {PIXEL_SIZE:.2e} m")
    print(f" -> A  : {A:.2e} J/m")
    print(f" -> Ku : {Ku:.2e} J/m^3")
    print(f" -> Ms : {Ms:.2e} A/m")
    print(f" -> R  : {R:.2e} m")
    print(f" -> lbp : {lbp:.4g} 1/nm")
    print(f" -> lbm : {lbm:.4g} 1/nm")
    print(f" -> kappa (computed)  : {kappa:.4f}")
    print(f" -> Display Plots : {show_plots}\n")
    print("="*50 + "\n")

    # --- Dynamic determination of the script's directory ---
    SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))

    # 2. Launching the physical computations
    t_sim_start = time.perf_counter()
    rho_grid, omega_bvp, y_vals, I_vals, phase_vals, thick_vals, contrast_vals = simulate_curling()
    t_sim = time.perf_counter() - t_sim_start

    # 3. Control plots
    t_plot_start = time.perf_counter()
    generate_plots(rho_grid, omega_bvp, y_vals, phase_vals, show_plots=show_plots)
    t_plot = time.perf_counter() - t_plot_start

    # 4. Normalization and export to 16-bit PNG format with metadata, and profiles along Ox
    t_export_start = time.perf_counter()
    export_16bit_maps(I_vals, phase_vals, thick_vals, contrast_vals, show_plots=show_plots)
    export_profiles(y_vals, I_vals, phase_vals, thick_vals, contrast_vals)
    t_export = time.perf_counter() - t_export_start

    t_total = time.perf_counter() - t_start_global

    # --- Execution timing report ---
    print("\n" + "="*50)
    print("TIMING BENCHMARK / BILAN TEMPS DE CALCUL:")
    print(f" -> Simulation & Numerical Solving : {t_sim:.4f} s")
    print(f" -> Control Plots Generation       : {t_plot:.4f} s")
    print(f" -> 16-bit Maps & Profiles Export  : {t_export:.4f} s")
    print("-" * 50)
    print(f" -> TOTAL EXECUTION TIME           : {t_total:.4f} s")
    print("="*50 + "\n")
