# Test case: curling cylinder, diameter 200 nm, length 1000 nm, Ku = -1e5 J/m^3
#
# Input files (not versioned, copied from Diwina_path_integral/simulations/curling):
#   cyl_D200_L1000_h5_noEnds_fg.msh : mesh (coordinates in nm, wire axis along z)
#   sol.in                          : curling magnetization generated by fg-gensol
#                                     (A = 1.3e-11 J/m, Ku = -1e5 J/m^3, Ms = 1.00531/mu_0 A/m)
# settings.yml points to these two files; the wire is rotated by 90 deg around x,
# so that the beam (z) is perpendicular to the wire. Sensor: 1001 x 1001 px, 1 nm.

# Access to feeLLGood Python Modules
export PYTHONPATH="/home/toussaij/Devel/FeeLLGood/python-modules:$PYTHONPATH"

# Calculating Holographic Phase, Mz integral, path length and STXM contrast maps
# (sim_HOLO_PHASE.png, sim_MZ.png, sim_PATH_LENGTH.png, sim_STXM_XMCD.png)
fmit-calculator settings.yml

# Calculating Fresnel Image from Holographic Phase and Thickness maps
fmit-fresnel sim_HOLO_PHASE.png sim_PATH_LENGTH.png

# Reference computed with curling_holo_simulator (infinite wire), same parameters
# (outputs analytics_*.png and profile_*.csv are written in the current directory)
../curling_holo_simulator 1001 1e-9 --R 100e-9 --A 1.3e-11 --Ku=-1e5 --no-plots

# Comparison: profiles of sim_PATH_LENGTH.png, sim_MZ.png and sim_STXM_XMCD.png across
# the wire (away from its ends) vs profile_PATH_LENGTH.csv, profile_MBEAM_INTEGRAL.csv
# and profile_STXM_XMCD.csv: they agree within 0.5 % (exit status 1 above --tol, 1 %)
./compare_diwina

# The holographic phase is not directly comparable: Diwina simulates a finite wire
# (stray field), curling_holo_simulator an infinite one.

